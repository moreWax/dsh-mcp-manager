{
  "name": "@morewax/dsh-mcp-manager",
  "description": "Add MCP servers from the harness UI \u2014 a + button by the composer with secure key storage",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-mcp-manager.git"
  },
  "main": "lib/host/index.mjs",
  "types": "lib/host/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.mts",
      "default": "./lib/host/index.mjs"
    },
    "./client": {
      "types": "./lib/client/index.d.mts",
      "default": "./lib/client/index.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./remote": {
      "types": "./lib/typert.remote-client.d.mts",
      "default": "./lib/typert.remote-client.mjs"
    },
    "./typert": {
      "types": "./lib/typert.host.d.mts",
      "default": "./lib/typert.host.mjs"
    }
  },
  "files": [
    "lib/**",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@types/node": "^22",
    "@types/react": "^18",
    "react": "^18",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "yaml": "^2.8.0",
    "zod": "4"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  }
}
